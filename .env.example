# Supabase — ตั้งค่าแล้ว Quick Capture / Veyra AI จะเรียก Claude ผ่าน Edge Functions, และ Settings จะมีปุ่ม
# เข้าสู่ระบบด้วย Google + cloud sync (ไม่ตั้ง = ใช้ engine ในเครื่อง, ข้อมูลอยู่ในเครื่องอย่างเดียว)
# ต้อง enable Google provider ใน Supabase Dashboard ด้วย — ดู supabase/functions/README.md § Cloud sync
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Veyra Pro (P4-06) — RevenueCat public SDK keys (Project settings → API keys). ไม่ตั้ง = ซื้อ Pro ในแอปไม่ได้
# (ยังให้ Pro แบบ manual ได้ — ดู supabase/functions/README.md § premium)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
